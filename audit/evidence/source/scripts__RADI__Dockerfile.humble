1: FROM node:24 AS ra-base
2: 
3: RUN apt-get update && apt-get install -y git zip
4: 
5: # RoboticsAcademy
6: ARG ROBOTICS_ACADEMY=$ROBOTICS_ACADEMY
7: ARG ACADEMY_OWNER=JdeRobot
8: RUN mkdir -p /tmp/dev
9: RUN git clone --depth 1 https://github.com/${ACADEMY_OWNER}/RoboticsAcademy.git -b $ROBOTICS_ACADEMY /tmp/app
10: WORKDIR /tmp/app
11: RUN cd common && cd console_interfaces && zip -r ../common.zip console_interfaces/ && cd .. && cd gui_interfaces && zip -r -u ../common.zip gui_interfaces/ && cd .. && cd hal_interfaces && zip -r -u ../common.zip hal_interfaces/ && cd ../.. && mv common/common.zip react_frontend/src/common.zip
12: WORKDIR /tmp/app/react_frontend
13: RUN yarn install && yarn run build
14: 
15: 
16: FROM jderobot/robotics-applications:dependencies-humble
17: 
18: WORKDIR /
19: 
20: # RoboticsInfrasctructure Repository
21: ARG ROBOTICS_INFRASTRUCTURE=$ROBOTICS_INFRASTRUCTURE
22: ARG INFRA_OWNER=JdeRobot
23: # Launchers/, Scenes/, Universes/ are intentionally retained in /opt/jderobot (hardcoded in all launch files).
24: # Only .git history is stripped to recover extra space.
25: RUN mkdir -p /opt/jderobot /home/ws/src && \
26:     git clone --depth 1 https://github.com/${INFRA_OWNER}/RoboticsInfrastructure.git -b $ROBOTICS_INFRASTRUCTURE /opt/jderobot && \
27:     mv /opt/jderobot/CustomRobots /opt/jderobot/jderobot_drones /opt/jderobot/jderobot_drones_cpp /opt/jderobot/Industrial /opt/jderobot/common_interfaces_cpp /home/ws/src/ && \
28:     mv /opt/jderobot/resources /resources && \
29:     mv -t / /opt/jderobot/scripts/.env /opt/jderobot/scripts/entrypoint.sh /opt/jderobot/scripts/ram_entrypoint.py /opt/jderobot/scripts/test/check_device.py /opt/jderobot/scripts/set_dri_name.sh /opt/jderobot/scripts/check_ram_version.sh && \
30:     mv -f /opt/jderobot/scripts/rc.xml /etc/xdg/openbox/LXDE/rc.xml && \
31:     chmod +x /entrypoint.sh /set_dri_name.sh && \
32:     rm -rf /opt/jderobot/.git \
33:     /opt/jderobot/.github \
34:     /opt/jderobot/database \
35:     /opt/jderobot/deprecated_assets \
36:     /opt/jderobot/Docs \
37:     /opt/jderobot/scripts \
38:     /opt/jderobot/test \
39:     /opt/jderobot/Universes \
40:     /opt/jderobot/utils \
41:     && rm -f /opt/jderobot/Scenes/*.glb
42: 
43: ARG IMAGE_TAG
44: ENV IMAGE_TAG=${IMAGE_TAG}
45: 
46: # Clone the RoboticsApplicationManager repository into the src folder inside RoboticsAcademy
47: RUN python3 -m pip install --no-cache-dir robotics_application_manager
48: 
49: # RoboticsAcademy
50: ARG ROBOTICS_ACADEMY=$ROBOTICS_ACADEMY
51: ARG ACADEMY_OWNER=JdeRobot
52: 
53: # Build react_fronted and create commons
54: RUN git clone --depth 1 https://github.com/${ACADEMY_OWNER}/RoboticsAcademy.git -b $ROBOTICS_ACADEMY /RoboticsAcademy/ \
55:     && rm -rf /RoboticsAcademy/.git \
56:     /RoboticsAcademy/compose_cfg \
57:     /RoboticsAcademy/docs \
58:     /RoboticsAcademy/scripts \
59:     /RoboticsAcademy/tests \
60:     /RoboticsAcademy/react_frontend \
61:     /RoboticsAcademy/common
62: 
63: COPY --from=ra-base /tmp/app/react_frontend/static /RoboticsAcademy/react_frontend/static
64: COPY --from=ra-base /tmp/app/react_frontend/templates /RoboticsAcademy/react_frontend/templates
65: COPY --from=ra-base /tmp/app/react_frontend/__init__.py /RoboticsAcademy/react_frontend/__init__.py
66: COPY --from=ra-base /tmp/app/react_frontend/apps.py /RoboticsAcademy/react_frontend/apps.py
67: COPY --from=ra-base /tmp/app/react_frontend/urls.py /RoboticsAcademy/react_frontend/urls.py
68: COPY --from=ra-base /tmp/app/react_frontend/views.py /RoboticsAcademy/react_frontend/views.py
69: COPY --from=ra-base /tmp/app/react_frontend/webpack-stats.json /RoboticsAcademy/react_frontend/webpack-stats.json
70: 
71: # Compiling and sourcing the workspace
72: WORKDIR /home/ws
73: RUN /bin/bash -c "source /opt/ros/humble/setup.bash; colcon build --symlink-install --packages-ignore gz_ros2_control gz_ros2_control_demos"
74: 
75: # Django server
76: EXPOSE 7164
77: 
78: # Manager websocket
79: EXPOSE 7163
80: 
81: # Tools ports
82: EXPOSE 6080-6090
83: 
84: #PostgreSQL Database
85: EXPOSE 5432
86: 
87: WORKDIR /
88: 
89: # Setting environment in both interactive or non-interactive shells
90: ENV BASH_ENV=/.env
91: ENTRYPOINT ["./entrypoint.sh"]
