152: # CUDA runtime wheels for onnxruntime-gpu==1.22.0 CUDA Execution Provider.
153: #
154: # All seven packages below must be upgraded together whenever onnxruntime-gpu
155: # is bumped. Compatibility ranges declared by the wheel (via ~= operator):
156: #   nvidia-cuda-runtime-cu12  ~= 12.0   nvidia-cuda-nvrtc-cu12 ~= 12.0
157: #   nvidia-cublas-cu12        (runtime dep of cudnn)
158: #   nvidia-cudnn-cu12         ~=  9.0
159: #   nvidia-curand-cu12        ~= 10.0   nvidia-cufft-cu12      ~= 11.0
160: #
161: # Upgrade checklist:
162: #   1. Check the new ORT release notes for CUDA / cuDNN major version changes.
163: #   2. Run: pip show onnxruntime-gpu | grep Requires  — to see declared ~= ranges.
164: #   3. Pick PyPI versions whose MAJOR matches those ranges (stay on CUDA 12.x,
165: #      cuDNN 9.x, curand 10.x, cufft 11.x until ORT itself changes the range).
166: #   4. After build, verify inside the container:
167: #        python3 -c "import onnxruntime as ort; print(ort.get_available_providers())"
168: #      CUDAExecutionProvider must appear first.
169: #   5. Run: ldd $(python3 -c "import onnxruntime, os; print(os.path.dirname(onnxruntime.__file__))")/capi/libonnxruntime_providers_cuda.so
170: #      Every .so must resolve (no "not found" lines).
171: RUN python3.10 -m pip install --no-cache-dir \
172:   nvidia-cuda-runtime-cu12==12.8.90 \
173:   nvidia-cublas-cu12==12.8.4.1 \
174:   nvidia-cudnn-cu12==9.10.2.21 \
175:   nvidia-nvjitlink-cu12==12.8.93 \
176:   nvidia-cuda-nvrtc-cu12==12.8.93 \
177:   nvidia-curand-cu12==10.3.10.19 \
178:   nvidia-cufft-cu12==11.4.1.4
